{:paths   ["src"]
 :deps    {org.clojure/clojure              {:mvn/version "1.12.0"}
           org.apache.jena/apache-jena-libs {:mvn/version "6.2.0"
                                             :extension   "pom"}
           ont-app/vocabulary               {:mvn/version "0.1.7"}

           ;; Adds missing javax.xml.bind.DatatypeConverter in Java 9+
           javax.xml.bind/jaxb-api          {:mvn/version "2.4.0-b180830.0359"}}
 :aliases {;; clojure -X:test  (logback prints Jena's log)
           :test {:extra-paths ["test"]
                  :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                                ch.qos.logback/logback-classic       {:mvn/version "1.6.5"}}
                  :main-opts   ["-m" "cognitect.test-runner"]
                  :exec-fn     cognitect.test-runner.api/test}

           ;; clojure -M:cljs compile test  (the tests of the cljc
           ;; namespaces in Node)
           :cljs {:extra-paths ["test"]
                  :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.8"}}
                  :main-opts   ["-m" "shadow.cljs.devtools.cli"]}

           ;; clojure -M:test:nrepl
           :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}}
                   ;; lets nrepl interrupt runaway evaluations
                   :jvm-opts   ["-Djdk.attach.allowAttachSelf"]
                   :main-opts  ["-m" "nrepl.cmdline"]}}}
